    {
      "id": 6,
      "type": "stat",
      "title": "Uptime by component",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${Site}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${Site}"
          },
          "editorMode": "code",
          "expr": "avg by (mapcolonies_io_component, mapcolonies_io_criticality) (avg_over_time((max by (mapcolonies_io_criticality, mapcolonies_io_part_of, mapcolonies_io_component, app_kubernetes_io_name) (label_replace(label_replace(up{mapcolonies_io_owner=\"$owner\", namespace=~\"$Namespace\", mapcolonies_io_part_of=\"$part_of\"}, \"app_kubernetes_io_name\", \"unnamed\", \"app_kubernetes_io_name\", \"\"), \"mapcolonies_io_criticality\", \"unassigned\", \"mapcolonies_io_criticality\", \"\")) or on (mapcolonies_io_criticality, mapcolonies_io_part_of, mapcolonies_io_component, app_kubernetes_io_name) ((0 * group by (mapcolonies_io_criticality, mapcolonies_io_part_of, mapcolonies_io_component, app_kubernetes_io_name) (label_replace(label_replace(last_over_time(up{mapcolonies_io_owner=\"$owner\", namespace=~\"$Namespace\", mapcolonies_io_part_of=\"$part_of\"}[10m]), \"app_kubernetes_io_name\", \"unnamed\", \"app_kubernetes_io_name\", \"\"), \"mapcolonies_io_criticality\", \"unassigned\", \"mapcolonies_io_criticality\", \"\"))) and on () (count(up) > 0)))[$__range:$__interval])) * 100",
          "legendFormat": "{{mapcolonies_io_component}} ({{mapcolonies_io_criticality}})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
