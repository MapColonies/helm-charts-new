{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "alerts": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "orgId": { "type": "integer" },
        "team": { "type": "string" },
        "folder": { "type": "string" },
        "interval": { "type": "string" },
        "deleteRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "orgId": { "type": "integer" },
              "uid": { "type": "string" }
            },
            "required": ["uid"]
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "expr": { "type": "string" },
              "severity": {
                "type": "string",
                "enum": ["critical", "warning", "info"]
              },
              "summary": { "type": "string" },
              "for": { "type": "string" },
              "description": { "type": "string" },
              "noDataState": {
                "type": "string",
                "default": "OK",
                "enum": ["OK", "NoData", "Alerting", "KeepLast"]
              },
              "execErrState": {
                "type": "string",
                "default": "Error",
                "enum": ["OK", "Error", "Alerting"]
              }
            },
            "required": ["name", "expr", "severity", "summary"]
          }
        }
      },
      "required": ["team"]
    }
  }
}
