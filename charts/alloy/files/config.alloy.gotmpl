// Receives the pod logs the alloy-logs StatefulSet tails, with their stream labels
loki.source.api "pod_logs" {
    http {
        listen_address = "0.0.0.0"
        listen_port    = {{ include "alloy-wrapper.podLogsPort" . }}
    }
    // Keep each line's own timestamp, so the age filter measures how old the log is
    use_incoming_timestamp = true
    forward_to             = [loki.process.limit_time.receiver]
}

loki.process "limit_time" {
    forward_to = [otelcol.receiver.loki.default.receiver]
    // Loki would reject older lines (see maxLogAge in values.yaml), so drop them here
    stage.drop {
        older_than          = {{ .Values.maxLogAge | quote }}
        drop_counter_reason = "too_old"
    }
{{- /* logFilters: values-driven keep/drop by log line content. Selector = namespace matcher + LogQL line filter, each regex JSON-quoted twice (LogQL string, then Alloy string).
       STOPGAP: regex keep/drop filters do not scale as more use cases are added. For new needs write a dedicated pipeline (its own loki.process with parsing, labels and routing) instead of more logFilters entries. */}}
{{- range $filter := .Values.logFilters }}
{{- $ns := $filter.namespace | default "" }}
{{- $matcher := ternary (printf "k8s_namespace_name=%s" ($ns | toJson)) `k8s_namespace_name=~".+"` (ne $ns "") }}
{{- range $re := $filter.keep }}
    stage.match {
        selector = {{ printf "{%s} !~ %s" $matcher ($re | toJson) | toJson }}
        action   = "drop"
        drop_counter_reason = "log_filter_keep"
    }
{{- end }}
{{- range $re := $filter.drop }}
    stage.match {
        selector = {{ printf "{%s} |~ %s" $matcher ($re | toJson) | toJson }}
        action   = "drop"
        drop_counter_reason = "log_filter_drop"
    }
{{- end }}
{{- end }}

{{- /* log sampling and dropping by level */}}
{{- range $level, $rawVal := (.Values.sampling | default dict).log }}
{{- if not (or (kindIs "float64" $rawVal) (kindIs "int" $rawVal) (kindIs "int64" $rawVal)) }}
    {{- fail (printf "Log sampling values must be a number between 0 and 1, got '%v'" $rawVal) -}}
{{- end }}
{{- $val := $rawVal | float64 -}}
{{- if or (lt $val 0.0) (gt $val 1.0) }}
    {{- fail (printf "Log sampling values must be a number between 0 and 1, got '%v'" $rawVal) -}}
{{- end }}
{{- if lt $val 1.0 }}
    stage.match {
        selector = "{level=\"{{ $level }}\"}"
        
        stage.sampling {
            rate = {{ $val }}
            drop_counter_reason = "{{ $level }}_sampled"
        }
    }
{{- end }}
{{- end }}
}

otelcol.receiver.loki "default" {
    output {
        logs = [otelcol.processor.transform.default.input]
    }
}

otelcol.processor.transform "default" {
    error_mode = "ignore"

    log_statements {
        context = "log"
        statements = [
            `set(resource.attributes, attributes)`,
            `delete_key(resource.attributes, "loki.attribute.labels")`,
            `replace_all_patterns(resource.attributes, "key","\\_", ".")`,
        ]
    }

    log_statements {
        context = "log"

        // Skips this entire block if the log isn't JSON
        conditions = [
            `IsMatch(body, "^\\s*\\{")`,
        ]

        statements = [
            `set(cache, ParseJSON(body))`,
            `set(severity_text, cache["SeverityText"]) where IsMap(cache)`,
            `set(severity_number, Int(cache["SeverityNumber"])) where IsMap(cache)`,
            `set(attributes, cache["Attributes"]) where IsMap(cache)`,
            `set(resource.attributes["_temp_resource"], cache["Resource"]) where IsMap(cache)`,
            `merge_maps(resource.attributes, resource.attributes["_temp_resource"], "upsert") where IsMap(resource.attributes["_temp_resource"])`,
            `delete_key(resource.attributes, "_temp_resource")`,

            // Context and tracing extractions
            `set(trace_id.string, cache["TraceId"]) where IsMap(cache)`,
            `set(span_id.string, cache["SpanId"]) where IsMap(cache)`,
            `set(instrumentation_scope.name, cache["InstrumentationScope"]) where IsMap(cache)`,

            // Explicit Int64 Casting for timestamps
            `set(time_unix_nano, Int(cache["Timestamp"])) where IsMap(cache)`,
            `set(body, cache["Body"]) where IsMap(cache)`,

            // Normalizes the newly merged JSON attributes
            `replace_all_patterns(resource.attributes, "key","\\_", ".")`,
        ]
    }

    output {
        logs = [otelcol.processor.filter.health_filter.input]
    }
}

{{- $namespaces := .Values.namespaces }}
{{- $lastIndex := sub (len $namespaces) 1 }}
otelcol.receiver.otlp "default" {
    grpc {}
    http {}

    output {
        logs   = [otelcol.processor.k8sattributes.add_k8s_attributes_{{ index $namespaces 0 | snakecase }}.input]
        traces = [otelcol.processor.k8sattributes.add_k8s_attributes_{{ index $namespaces 0 | snakecase }}.input]
    }
}

{{- range $index, $namespace := $namespaces }}
otelcol.processor.k8sattributes "add_k8s_attributes_{{ $namespace | snakecase }}" {
    filter {
        namespace = {{ $namespace | quote }}
    }

    extract {
        metadata = [
            "k8s.deployment.name", "k8s.namespace.name", "k8s.pod.name",
            "k8s.pod.start_time", "k8s.statefulset.name", "k8s.pod.uid",
            "k8s.container.name", "k8s.node.name", "k8s.cronjob.name", "k8s.job.name",
        ]

        label {
            from = "pod"
            key = "mapcolonies.io/owner"
            tag_name = "owner"
        }

        label {
            from = "pod"
            key = "mapcolonies.io/environment"
            tag_name = "deployment.environment.name"
        }
    }

    pod_association {
        source {
            from = "resource_attribute"
            name = "k8s.pod.uid"
        }
    }
    {{ if eq $index $lastIndex -}}
    output {
        logs   = [otelcol.processor.filter.health_filter.input]
        traces = [otelcol.processor.batch.default.input]
    }
    {{- else }}
    {{- $nextIndex := add $index 1 -}}
    output {
        logs   = [otelcol.processor.k8sattributes.add_k8s_attributes_{{ index $namespaces $nextIndex | snakecase }}.input]
        traces = [otelcol.processor.k8sattributes.add_k8s_attributes_{{ index $namespaces $nextIndex | snakecase }}.input]
    }
    {{- end }}
}
{{ end }}

otelcol.processor.filter "health_filter" {
    error_mode = "ignore"
    logs {
        log_record = [
        `attributes["url.path"] == "/health"`,
        `attributes["url.path"] == "/liveness"`,
        `attributes["url.path"] == "/metrics"`,
        ]
    }

    output {
        logs = [otelcol.processor.batch.default.input]
    }
}

otelcol.processor.batch "default" {
    timeout = {{ .Values.batching.timeout | default "5s" | quote }}
    send_batch_size = {{ .Values.batching.send_batch_size | default 2048 }}
    send_batch_max_size = {{ .Values.batching.send_batch_max_size | default 4096 }}

    output {
        logs = [otelcol.exporter.otlphttp.default.input]
        traces = [otelcol.exporter.otlphttp.default.input]
    }
}

otelcol.exporter.otlphttp "default" {
    client {
        endpoint = {{ .Values.exporter.endpoint | default "http://infra-loki-gateway/otlp" | quote }}
        // How long one export attempt may take; the last retry can start just before
        // retry_on_failure.max_elapsed_time ends and still run this long
        timeout  = {{ .Values.exporter.timeout | default "30s" | quote }}
    }
    sending_queue {
        enabled      = true
        num_consumers = {{ .Values.exporter.sending_queue.num_consumers | default 4 }}
        // Sized to the pod's memory limit; when full, new batches are dropped instead of blocking
        queue_size   = {{ include "alloy-wrapper.queueSize" . }}
        block_on_overflow = false
    }
    retry_on_failure {
        enabled         = true
        initial_interval = {{ .Values.exporter.retry_on_failure.initial_interval | default "10s" | quote }}
        max_interval    = {{ .Values.exporter.retry_on_failure.max_interval | default "30s" | quote }}
        max_elapsed_time = {{ .Values.exporter.retry_on_failure.max_elapsed_time | default "60s" | quote }}
    }
}

tracing {
    sampling_fraction = 0.1
    write_to          = [otelcol.processor.batch.alloy_traces.input]
}

otelcol.processor.batch "alloy_traces" {
    timeout         = "5s"
    send_batch_size = 1024

    output {
        traces = [otelcol.exporter.otlp.tempo.input]
    }
}

otelcol.exporter.otlp "tempo" {
    client {
        endpoint = "infra-otel.{{ .Values.namespaces | first }}.svc.cluster.local:4317"

        tls {
            insecure = true
        }
    }
}
