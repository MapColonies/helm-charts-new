{{- $namespaces := .Values.namespaces }}
{{- $lastIndex := sub (len $namespaces) 1 }}
otelcol.receiver.otlp "default" {
    grpc {}
    http {}

    output {
        logs   = [otelcol.processor.k8sattributes.add_k8s_attributes_{{ index $namespaces 0 | snakecase }}.input]
        traces = [otelcol.processor.k8sattributes.add_k8s_attributes_{{ index $namespaces 0 | snakecase }}.input]
    }
}

{{- range $index, $namespace := $namespaces }}
otelcol.processor.k8sattributes "add_k8s_attributes_{{ $namespace | snakecase }}" {
    filter {
        namespace = {{ $namespace | quote }}
    }

    extract {
        metadata = [
            "k8s.deployment.name", "k8s.namespace.name", "k8s.pod.name",
            "k8s.pod.start_time", "k8s.statefulset.name", "k8s.pod.uid",
            "k8s.container.name", "k8s.node.name", "k8s.cronjob.name", "k8s.job.name",
        ]

        label {
            from = "pod"
            key = "mapcolonies.io/owner"
            tag_name = "owner"
        }

        label {
            from = "pod"
            key = "mapcolonies.io/environment"
            tag_name = "deployment.environment.name"
        }
    }

    pod_association {
        source {
            from = "resource_attribute"
            name = "k8s.pod.uid"
        }
    }
    {{ if eq $index $lastIndex -}}
    output {
        logs   = [otelcol.processor.filter.health_filter.input]
        traces = [otelcol.processor.batch.default.input]
    }
    {{- else }}
    {{- $nextIndex := add $index 1 -}}
    output {
        logs   = [otelcol.processor.k8sattributes.add_k8s_attributes_{{ index $namespaces $nextIndex | snakecase }}.input]
        traces = [otelcol.processor.k8sattributes.add_k8s_attributes_{{ index $namespaces $nextIndex | snakecase }}.input]
    }
    {{- end }}
}
{{ end }}

{{ include "alloy-wrapper.config.export" . }}
