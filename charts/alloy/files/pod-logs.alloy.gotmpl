// discovery.kubernetes allows you to find scrape targets from Kubernetes resources.
// It watches cluster state and ensures targets are continually synced with what is currently running in your cluster.
discovery.kubernetes "pod" {
    role = "pod"
    selectors {
        role = "pod"
        label = "mapcolonies.io/alloy-api-logs=true"
    }
    namespaces {
        names = {{ .Values.namespaces | toJson }}
    }
}

// discovery.relabel rewrites the label set of the input targets by applying one or more relabeling rules.
// If no rules are defined, then the input targets are exported as-is.
discovery.relabel "pod_logs" {
    targets = discovery.kubernetes.pod.targets

    // Label creation - "k8s_namespace_name" field from "__meta_kubernetes_namespace"
    rule {
        source_labels = ["__meta_kubernetes_namespace"]
        action = "replace"
        target_label = "k8s_namespace_name"
    }

    // Label creation - "k8s_pod_name" field from "__meta_kubernetes_pod_name"
    rule {
        source_labels = ["__meta_kubernetes_pod_name"]
        action = "replace"
        target_label = "k8s_pod_name"
    }

    // Label creation - "k8s_container_name" field from "__meta_kubernetes_pod_container_name"
    rule {
        source_labels = ["__meta_kubernetes_pod_container_name"]
        action = "replace"
        target_label = "k8s_container_name"
    }

    // Label creation -  "owner" field from "__meta_kubernetes_pod_label_mapcolonies_io_owner"
    rule {
        source_labels = ["__meta_kubernetes_pod_label_mapcolonies_io_owner"]
        action = "replace"
        target_label = "owner"
    }

    // Label creation - "k8s_statefulset_name" when pod is owned by a StatefulSet
    rule {
        source_labels = ["__meta_kubernetes_pod_controller_kind", "__meta_kubernetes_pod_controller_name"]
        separator     = ";"
        regex         = "StatefulSet;(.*)"
        target_label  = "k8s_statefulset_name"
        replacement   = "$1"
    }

    // Label creation - "k8s_deployment_name" when pod is owned by a ReplicaSet (strip the hash suffix)
    rule {
        source_labels = ["__meta_kubernetes_pod_controller_kind", "__meta_kubernetes_pod_controller_name"]
        separator     = ";"
        regex         = "ReplicaSet;(.*)-[^-]+"
        target_label  = "k8s_deployment_name"
        replacement   = "$1"
    }
}

// loki.source.kubernetes tails logs from Kubernetes containers using the Kubernetes API.
loki.source.kubernetes "pod_logs" {
    targets    = discovery.relabel.pod_logs.output
    forward_to = [loki.process.limit_time.receiver]

    // Split the pods between the replicas, so each pod is tailed by one replica only.
    // alloy.clustering.enabled only forms the cluster, every component has to opt in.
    clustering {
        enabled = true
    }
}

loki.process "limit_time" {
    forward_to = [otelcol.receiver.loki.default.receiver]
    // Loki would reject older lines (see maxLogAge in values.yaml), so drop them here
    stage.drop {
        older_than          = {{ .Values.maxLogAge | quote }}
        drop_counter_reason = "too_old"
    }
{{- /* logFilters: values-driven keep/drop by log line content. Selector = namespace matcher + LogQL line filter, each regex JSON-quoted twice (LogQL string, then Alloy string).
       STOPGAP: regex keep/drop filters do not scale as more use cases are added. For new needs write a dedicated pipeline (its own loki.process with parsing, labels and routing) instead of more logFilters entries. */}}
{{- range $filter := .Values.logFilters }}
{{- $ns := $filter.namespace | default "" }}
{{- $matcher := ternary (printf "k8s_namespace_name=%s" ($ns | toJson)) `k8s_namespace_name=~".+"` (ne $ns "") }}
{{- range $re := $filter.keep }}
    stage.match {
        selector = {{ printf "{%s} !~ %s" $matcher ($re | toJson) | toJson }}
        action   = "drop"
        drop_counter_reason = "log_filter_keep"
    }
{{- end }}
{{- range $re := $filter.drop }}
    stage.match {
        selector = {{ printf "{%s} |~ %s" $matcher ($re | toJson) | toJson }}
        action   = "drop"
        drop_counter_reason = "log_filter_drop"
    }
{{- end }}
{{- end }}
}

otelcol.receiver.loki "default" {
    output {
        logs = [otelcol.processor.transform.default.input]
    }
}

otelcol.processor.transform "default" {
    error_mode = "ignore"

    log_statements {
        context = "log"
        statements = [
            `set(resource.attributes, attributes)`,
            `delete_key(resource.attributes, "loki.attribute.labels")`,
            `replace_all_patterns(resource.attributes, "key","\\_", ".")`,
        ]
    }

    log_statements {
        context = "log"

        // Skips this entire block if the log isn't JSON
        conditions = [
            `IsMatch(body, "^\\s*\\{")`,
        ]

        statements = [
            `set(cache, ParseJSON(body))`,
            `set(severity_text, cache["SeverityText"]) where IsMap(cache)`,
            `set(severity_number, Int(cache["SeverityNumber"])) where IsMap(cache)`,
            `set(attributes, cache["Attributes"]) where IsMap(cache)`,
            `set(resource.attributes["_temp_resource"], cache["Resource"]) where IsMap(cache)`,
            `merge_maps(resource.attributes, resource.attributes["_temp_resource"], "upsert") where IsMap(resource.attributes["_temp_resource"])`,
            `delete_key(resource.attributes, "_temp_resource")`,

            // Context and tracing extractions
            `set(trace_id.string, cache["TraceId"]) where IsMap(cache)`,
            `set(span_id.string, cache["SpanId"]) where IsMap(cache)`,
            `set(instrumentation_scope.name, cache["InstrumentationScope"]) where IsMap(cache)`,

            // Explicit Int64 Casting for timestamps
            `set(time_unix_nano, Int(cache["Timestamp"])) where IsMap(cache)`,
            `set(body, cache["Body"]) where IsMap(cache)`,

            // Normalizes the newly merged JSON attributes
            `replace_all_patterns(resource.attributes, "key","\\_", ".")`,
        ]
    }

    output {
        logs = [otelcol.processor.filter.health_filter.input]
    }
}

{{ include "alloy-wrapper.config.export" (dict "root" . "values" (index .Values "alloy-logs").alloy) }}
